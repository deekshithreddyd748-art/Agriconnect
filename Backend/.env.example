# Backend Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase (Server-Only — NEVER expose SUPABASE_SERVICE_ROLE_KEY in Frontend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# MongoDB Operational Store (Machinery, Labour, Facilities, Bookings, Labour Requests)
MONGO_URI=mongodb://127.0.0.1:27017/agriconnect
AUTO_SEED=true

# Session Token Signing (Profile Identification Session)
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d
