PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/agriconnect
JWT_SECRET=replace_with_a_strong_random_secret_for_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173,https://agriconnect-deekshithreddyd748-6042.vercel.app
AUTO_SEED=true

# Real Indian SMS OTP Provider Configuration
# Pick one: msg91 | twilio_verify | 2factor | twilio
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SERVER_VERIFY=true
#
# Or Twilio Verify (server-side SMS OTP generation & verification):
# SMS_PROVIDER=twilio_verify
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
#
# Or 2Factor / Twilio Programmable Messaging:
# TWOFACTOR_API_KEY=
# TWOFACTOR_TEMPLATE_NAME=
# TWILIO_FROM_NUMBER=
